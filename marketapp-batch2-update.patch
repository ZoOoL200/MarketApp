+using System.Net;
+using System.Net.Http.Json;
+using System.Security.Cryptography;
+using System.Text.Json;
+using MarketApp.Application.Common;
+using MarketApp.Application.Common.Security;
+using MarketApp.Application.DTOs.Sales;
