+@baseUrl = https://localhost:7126
+@sellerToken = PASTE_SELLER_ACCESS_TOKEN
+@managerToken = PASTE_MANAGER_ACCESS_TOKEN
+@username = REPLACE_WITH_SELLER_USERNAME
+@password = REPLACE_WITH_PASSWORD
+@branchId = REPLACE_WITH_BRANCH_GUID
+@locationId = REPLACE_WITH_LOCATION_GUID
+@productId = REPLACE_WITH_PRODUCT_GUID
+@priceRevision = 1
+@clientSaleId = 11111111-1111-4111-8111-111111111111
+@saleId = REPLACE_WITH_RETURNED_INVOICE_GUID
+
+### 1 Login with an existing seller; copy accessToken above
+POST {{baseUrl}}/api/auth/login
+Content-Type: application/json
+
+{
+  "userName": "{{username}}",
+  "password": "{{password}}"
+}
+
+### 2 Seller catalog: copy product ID and current priceRevision
+GET {{baseUrl}}/api/branches/{{branchId}}/catalog?pageNumber=1&pageSize=25
+Authorization: Bearer {{sellerToken}}
+
+### 3 Active locations: copy location ID
+GET {{baseUrl}}/api/branches/{{branchId}}/catalog/locations
+Authorization: Bearer {{sellerToken}}
+
+### 4 Available stock before and after the sale
+GET {{baseUrl}}/api/branches/{{branchId}}/catalog/stock?locationId={{locationId}}
+Authorization: Bearer {{sellerToken}}
+
+### 5 Post sale; use a NEW clientSaleId for each NEW sale
+# Example price 170 must be at least the current minimum.
+# Send this exact request again to test retry: 201 first, 200 repeat.
+# Keep the clientSaleId fixed for retry; do not use a changing GUID macro.
+POST {{baseUrl}}/api/branches/{{branchId}}/sales
+Authorization: Bearer {{sellerToken}}
+Content-Type: application/json
+
+{
+  "clientSaleId": "{{clientSaleId}}",
+  "inventoryLocationId": "{{locationId}}",
+  "notes": "Batch 1 test sale",
+  "lines": [
+    {
+      "productId": "{{productId}}",
+      "quantity": 2,
+      "sellingUnitPrice": 170,
+      "priceRevision": {{priceRevision}}
+    }
+  ]
+}
+
+### 6 Invoice detail: copy the returned invoice ID into saleId
+GET {{baseUrl}}/api/branches/{{branchId}}/sales/{{saleId}}
+Authorization: Bearer {{sellerToken}}
+
+### 7 Seller sees only their invoices
+GET {{baseUrl}}/api/branches/{{branchId}}/sales?pageNumber=1&pageSize=25
+Authorization: Bearer {{sellerToken}}
+
+### 8 Manager sees invoices for this assigned branch
+GET {{baseUrl}}/api/branches/{{branchId}}/sales?pageNumber=1&pageSize=25
+Authorization: Bearer {{managerToken}}
+
+### 9 Seller cannot access management baseline pricing: expect 403
+GET {{baseUrl}}/api/branches/{{branchId}}/product-prices/{{productId}}
+Authorization: Bearer {{sellerToken}}
