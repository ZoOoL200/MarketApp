@baseUrl = https://localhost:7126
@categoryId = 5f2e9778-e1b7-4dff-89ad-3075c0e20482
@productId = ca6f2e9a-24b5-4194-bb2a-66ce34b6a469

### Get categories to choose an existing ID
GET {{baseUrl}}/api/categories

### Create a product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Orange Juice 1L",
  "sku": " bev-001 ",
  "categoryId": "{{categoryId}}",
  "isActive": true
}

### Get the first page
GET {{baseUrl}}/api/products?pageNumber=1&pageSize=20

### Filter active products by category
GET {{baseUrl}}/api/products?categoryId={{categoryId}}&isActive=true

### Get one product
GET {{baseUrl}}/api/products/{{productId}}

### Update and deactivate the product
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json

{
  "name": "Orange Juice 1L",
  "sku": "BEV-001",
  "categoryId": "{{categoryId}}",
  "isActive": true
}

### Duplicate SKU
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Another Juice",
  "sku": "bev-001",
  "categoryId": "{{categoryId}}",
  "isActive": true
}

### Invalid category
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Test Product",
  "sku": "TEST-002",
  "categoryId": "00000000-0000-0000-0000-000000000000",
  "isActive": true
}

### Invalid page size
GET {{baseUrl}}/api/products?pageSize=201