@baseUrl = https://localhost:7126

@stakeholderToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..cJ37OpsyVxD3kuZNkXZviXdFlHVrKLvVOH-JXgkrXnA
@managerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..L9Nci4-rWHyCbQW_H8tN4U8ORKlCT_h8MHzvpsvMKj4
@sellerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.._vDiGOVyPfnUcsNWAzvmbWzNpBnlphTG1D40BeSLzmM

@branchId = ba7c4374-a68b-4c60-ab06-55ac62505670
@otherBranchId = 277d0078-a483-440b-bae4-214b77ac9466
@productId = ca6f2e9a-24b5-4194-bb2a-66ce34b6a469

### Read the management price
GET {{baseUrl}}/api/branches/{{branchId}}/product-prices/{{productId}}
Authorization: Bearer {{stakeholderToken}}

### Stakeholder sets the baseline
PUT {{baseUrl}}/api/branches/{{branchId}}/product-prices/{{productId}}/baseline
Authorization: Bearer {{stakeholderToken}}
Content-Type: application/json

{
  "price": 100,
  "expectedRevision": 0,
  "reason": "Initial baseline"
}

### Manager sets the minimum selling price
PUT {{baseUrl}}/api/branches/{{branchId}}/product-prices/{{productId}}/minimum-selling-price
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "price": 125,
  "expectedRevision": 1,
  "reason": "Initial selling price"
}

### Seller reads the selling price
GET {{baseUrl}}/api/branches/{{branchId}}/selling-prices/{{productId}}
Authorization: Bearer {{sellerToken}}

### Manager reads pricing history
GET {{baseUrl}}/api/branches/{{branchId}}/product-prices/{{productId}}/history?pageNumber=1&pageSize=20
Authorization: Bearer {{managerToken}}

### Seller attempts to read management prices
GET {{baseUrl}}/api/branches/{{branchId}}/product-prices/{{productId}}
Authorization: Bearer {{sellerToken}}

### Seller attempts to access another branch
GET {{baseUrl}}/api/branches/{{otherBranchId}}/selling-prices/{{productId}}
Authorization: Bearer {{sellerToken}}