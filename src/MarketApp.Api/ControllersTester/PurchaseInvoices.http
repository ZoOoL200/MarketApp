@baseUrl = https://localhost:7126
@supplierId = ed0d3083-a567-43f5-b386-611e2b9c766e
@locationId = 204f06e3-e969-41fd-9c7c-1ba6eff901a6
@productId = ca6f2e9a-24b5-4194-bb2a-66ce34b6a469
@invoiceId = dc44aa7a-3c98-4ca7-9651-45943b4557b1

### Create a draft with the same product on two lines
POST {{baseUrl}}/api/purchase-invoices
Content-Type: application/json

{
  "supplierId": "{{supplierId}}",
  "inventoryLocationId": "{{locationId}}",
  "invoiceDate": "2026-09-26",
  "supplierInvoiceNumber": "SUP-INV-001",
  "notes": "First test purchase",
  "lines": [
    {
      "productId": "{{productId}}",
      "quantity": 10,
      "unitCost": 5
    },
    {
      "productId": "{{productId}}",
      "quantity": 5,
      "unitCost": 4
    }
  ]
}

### Read the invoice
GET {{baseUrl}}/api/purchase-invoices/{{invoiceId}}

### Post the invoice
POST {{baseUrl}}/api/purchase-invoices/{{invoiceId}}/post

### Repeat posting — stock must not increase again
POST {{baseUrl}}/api/purchase-invoices/{{invoiceId}}/post

### Reject zero purchase quantity
POST {{baseUrl}}/api/purchase-invoices
Content-Type: application/json

{
  "supplierId": "{{supplierId}}",
  "inventoryLocationId": "{{locationId}}",
  "invoiceDate": "2026-09-26",
  "lines": [
    {
      "productId": "{{productId}}",
      "quantity": 0,
      "unitCost": 5
    }
  ]
}

### Reject an empty invoice
POST {{baseUrl}}/api/purchase-invoices
Content-Type: application/json

{
  "supplierId": "{{supplierId}}",
  "inventoryLocationId": "{{locationId}}",
  "invoiceDate": "2026-09-26",
  "lines": []
}