@host = https://localhost:7126
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..HBCFuytS5qQeCle23O-rcs_SGFHbRb6iV8DouSklYuE
@productId = ca6f2e9a-24b5-4194-bb2a-66ce34b6a469
@photoId = b4eb3008-97e4-4533-bbc6-0cb4adfbdd62

### List ready photos in display order
GET {{host}}/api/products/{{productId}}/photos
Authorization: Bearer {{token}}

### Download a photo with your current access token
GET {{host}}/api/products/{{productId}}/photos/{{photoId}}/content
Authorization: Bearer {{token}}

### Change order as stakeholder
PUT {{host}}/api/products/{{productId}}/photos/{{photoId}}/order
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sortOrder": 0 }

### Delete as stakeholder; repeat is safe
DELETE {{host}}/api/products/{{productId}}/photos/{{photoId}}
Authorization: Bearer {{token}}

# Upload is multipart/form-data. See docs/product-photos.md for curl.exe examples.
# Use Seller / BranchManager tokens to confirm reads succeed and writes return 403.
