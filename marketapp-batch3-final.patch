diff --git a/src/MarketApp.Application/Services/ManagerProfitShareService.cs b/src/MarketApp.Application/Services/ManagerProfitShareService.cs
new file mode 100644
index 0000000..e575a35
--- /dev/null
+++ b/src/MarketApp.Application/Services/ManagerProfitShareService.cs
@@ -0,0 +1,40 @@
+using System.ComponentModel.DataAnnotations;
+using System.Security.Cryptography;
+using System.Text.Json;
+using MarketApp.Application.Common.Exceptions;
+using MarketApp.Application.Common.Security;
+using MarketApp.Application.DTOs.Sales;
+using MarketApp.Application.Interfaces.Services;
+using MarketApp.Application.Persistence.Contracts;
+using MarketApp.Domain.Entity.Sales;
+namespace MarketApp.Application.Services;
+public sealed class ManagerProfitShareService(IUnitOfWork work, ISalesQueries queries) : IManagerProfitShareService
+{
+    public static ProfitShareDto ToDto(ManagerProfitShare value) => new(value.Id, value.ClientChangeId,
+        value.ManagerUserId, value.Percent, value.EffectiveFromUtc, value.CreatedByUserId, value.Reason);
+    public async Task<ProfitShareDto> SetAsync(Guid branchId, Guid actorId, SetProfitShareDto request, CancellationToken ct)
+    {
+        var errors = new List<ValidationResult>();
+        if (!Validator.TryValidateObject(request, new ValidationContext(request), errors, true) ||
+            request.ClientChangeId == Guid.Empty || request.ManagerUserId == Guid.Empty || string.IsNullOrWhiteSpace(request.Reason) ||
+            (request.Percent.HasValue && decimal.Round(request.Percent.Value, 4) != request.Percent.Value))
+            throw new RequestException(400, "Provide a change ID, manager, reason, and percentage from 0 to 100 with at most four decimal places.");
+        var hash = Convert.ToHexString(SHA256.HashData(JsonSerializer.SerializeToUtf8Bytes(new { branchId, actorId, request })));
+        await using var transaction = await work.BeginSerializableAsync(ct);
+        var previous = await work.ManagerProfitShares.FindAsync(s => s.BranchId == branchId && s.ClientChangeId == request.ClientChangeId, cancellationToken: ct);
+        if (previous is not null)
+        {
+            if (previous.RequestHash != hash) throw new ConflictException("This change identifier already has different data or a different user.");
+            return ToDto(previous);
+        }
+        if (!await work.Branches.AnyAsync(b => b.Id == branchId && b.IsActive, ct)) throw new ConflictException("Branch is missing or inactive.");
+        if (!await queries.IsAssignedUserAsync(branchId, request.ManagerUserId, AppRoles.BranchManager, ct))
